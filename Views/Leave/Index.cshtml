@model List<EmployeeLeavePortal.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Requests";

    var employees = ViewBag.Employees as List<EmployeeLeavePortal.Models.Employee>
                     ?? new List<EmployeeLeavePortal.Models.Employee>();
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Leave Requests</h2>

            <p class="text-muted mb-0">
                Review and manage employee leave requests
            </p>
        </div>

        <a asp-controller="Leave"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            New Leave Request

        </a>

    </div>


    <!-- Filters -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3">

                <!-- Search -->
                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Search
                    </label>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Employee name or Request ID..." />

                </div>


                <!-- Status Filter -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="All"
                                selected="@(ViewBag.Status == "All" || string.IsNullOrEmpty(ViewBag.Status) ? "selected" : null)">
                            All Statuses
                        </option>

                        <option value="Pending"
                                selected="@(ViewBag.Status == "Pending" ? "selected" : null)">
                            Pending
                        </option>

                        <option value="Approved"
                                selected="@(ViewBag.Status == "Approved" ? "selected" : null)">
                            Approved
                        </option>

                        <option value="Rejected"
                                selected="@(ViewBag.Status == "Rejected" ? "selected" : null)">
                            Rejected
                        </option>

                    </select>

                </div>


                <!-- Leave Type Filter -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Leave Type
                    </label>

                    <select name="leaveType"
                            class="form-select">

                        <option value="All"
                                selected="@(ViewBag.LeaveType == "All" || string.IsNullOrEmpty(ViewBag.LeaveType) ? "selected" : null)">
                            All Leave Types
                        </option>

                        <option value="Sick Leave"
                                selected="@(ViewBag.LeaveType == "Sick Leave" ? "selected" : null)">
                            Sick Leave
                        </option>

                        <option value="Casual Leave"
                                selected="@(ViewBag.LeaveType == "Casual Leave" ? "selected" : null)">
                            Casual Leave
                        </option>

                        <option value="Annual Leave"
                                selected="@(ViewBag.LeaveType == "Annual Leave" ? "selected" : null)">
                            Annual Leave
                        </option>

                        <option value="Work From Home"
                                selected="@(ViewBag.LeaveType == "Work From Home" ? "selected" : null)">
                            Work From Home
                        </option>

                    </select>

                </div>


                <!-- Search / Clear -->
                <div class="col-md-2 d-flex align-items-end gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search"></i>
                        Search

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Clear

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- Leave Requests Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Request ID</th>

                            <th>Employee</th>

                            <th>Leave Type</th>

                            <th>From</th>

                            <th>To</th>

                            <th>Days</th>

                            <th>Reason</th>

                            <th>Status</th>

                            <th class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var request in Model)
                            {
                                var employee = employees.FirstOrDefault(
                                    e => e.EmployeeId == request.EmployeeId);

                                <tr>

                                    <!-- Request ID -->
                                    <td>

                                        <span class="fw-semibold">
                                            @request.RequestId
                                        </span>

                                    </td>


                                    <!-- Employee -->
                                    <td>

                                        @if (employee != null)
                                        {
                                            <div class="fw-semibold">
                                                @employee.FullName
                                            </div>

                                            <small class="text-muted">
                                                @employee.EmployeeId
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unknown Employee
                                            </span>
                                        }

                                    </td>


                                    <!-- Leave Type -->
                                    <td>

                                        <span class="badge bg-light text-dark">
                                            @request.LeaveType
                                        </span>

                                    </td>


                                    <!-- From Date -->
                                    <td>
                                        @request.FromDate.ToString("dd MMM yyyy")
                                    </td>


                                    <!-- To Date -->
                                    <td>
                                        @request.ToDate.ToString("dd MMM yyyy")
                                    </td>


                                    <!-- Total Days -->
                                    <td>

                                        <span class="fw-semibold">
                                            @request.TotalLeaveDays
                                        </span>

                                    </td>


                                    <!-- Reason -->
                                    <td>

                                        <span title="@request.Reason">

                                            @(request.Reason.Length > 25
                                                ? request.Reason.Substring(0, 25) + "..."
                                                : request.Reason)

                                        </span>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (request.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (request.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-1">

                                            <!-- View Button -->
                                            <a asp-action="Details"
                                               asp-route-id="@request.RequestId"
                                               class="btn btn-sm btn-outline-info"
                                               title="View">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            @if (request.Status == "Pending")
                                            {
                                                <!-- Approve Button -->
                                                <form asp-action="Approve"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@request.RequestId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Approve"
                                                            onclick="return confirm('Are you sure you want to approve this leave request?');">

                                                        <i class="bi bi-check-lg"></i>

                                                    </button>

                                                </form>


                                                <!-- Reject Button -->
                                                <form asp-action="Reject"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@request.RequestId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Reject"
                                                            onclick="return confirm('Are you sure you want to reject this leave request?');">

                                                        <i class="bi bi-x-lg"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                                    No leave requests found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>