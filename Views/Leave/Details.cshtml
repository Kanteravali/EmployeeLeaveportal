@model EmployeeLeavePortal.Models.LeaveRequest

@{
    ViewData["Title"] = "Leave Request Details";

    var employees = ViewBag.Employees as List<EmployeeLeavePortal.Models.Employee>
                     ?? new List<EmployeeLeavePortal.Models.Employee>();

    var employee = employees.FirstOrDefault(
        e => e.EmployeeId == Model.EmployeeId);
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Leave Request Details</h2>
            <p class="text-muted mb-0">
                View complete information about this leave request
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to Requests

        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="row g-4">

                <!-- Request ID -->
                <div class="col-md-6">

                    <label class="text-muted small">
                        Request ID
                    </label>

                    <div class="fw-semibold fs-5">
                        #@Model.RequestId
                    </div>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <label class="text-muted small">
                        Status
                    </label>

                    <div class="mt-1">

                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }

                    </div>

                </div>


                <!-- Employee -->
                <div class="col-md-6">

                    <label class="text-muted small">
                        Employee
                    </label>

                    <div class="fw-semibold">

                        @if (employee != null)
                        {
                            @employee.FullName
                        }
                        else
                        {
                            <span>Unknown Employee</span>
                        }

                    </div>

                    @if (employee != null)
                    {
                        <small class="text-muted">
                            @employee.EmployeeId
                        </small>
                    }

                </div>


                <!-- Leave Type -->
                <div class="col-md-6">

                    <label class="text-muted small">
                        Leave Type
                    </label>

                    <div class="fw-semibold">
                        @Model.LeaveType
                    </div>

                </div>


                <!-- From Date -->
                <div class="col-md-4">

                    <label class="text-muted small">
                        From Date
                    </label>

                    <div class="fw-semibold">
                        @Model.FromDate.ToString("dd MMM yyyy")
                    </div>

                </div>


                <!-- To Date -->
                <div class="col-md-4">

                    <label class="text-muted small">
                        To Date
                    </label>

                    <div class="fw-semibold">
                        @Model.ToDate.ToString("dd MMM yyyy")
                    </div>

                </div>


                <!-- Total Days -->
                <div class="col-md-4">

                    <label class="text-muted small">
                        Total Leave Days
                    </label>

                    <div class="fw-semibold">
                        @Model.TotalLeaveDays day(s)
                    </div>

                </div>


                <!-- Request Date -->
                <div class="col-md-6">

                    <label class="text-muted small">
                        Request Date
                    </label>

                    <div class="fw-semibold">
                        @Model.RequestDate.ToString("dd MMM yyyy hh:mm tt")
                    </div>

                </div>


                <!-- Reason -->
                <div class="col-12">

                    <label class="text-muted small">
                        Reason
                    </label>

                    <div class="reason-box mt-2">
                        @Model.Reason
                    </div>

                </div>

            </div>


            <!-- Actions -->
            @if (Model.Status == "Pending")
            {
                <div class="border-top mt-4 pt-4">

                    <div class="d-flex gap-2">

                        <form asp-action="Approve"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.RequestId" />

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-check-lg"></i>
                                Approve Request

                            </button>

                        </form>


                        <form asp-action="Reject"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.RequestId" />

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-x-lg"></i>
                                Reject Request

                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>

    </div>

</div>