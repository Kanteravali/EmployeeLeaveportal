@model List<EmployeeLeavePortal.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Employees</h2>
            <p class="text-muted mb-0">
                Manage employee information
            </p>
        </div>

        <a asp-controller="Employee"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Employee
        </a>
    </div>

    <!-- Search and Filter -->

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3">

                <div class="col-md-5">
                    <label class="form-label fw-semibold">
                        Search Employee
                    </label>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search by employee name..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Department
                    </label>

                    <select name="department"
                            class="form-select">

                        <option value="">All Departments</option>

                        @foreach (var department in ViewBag.Departments)
                        {
                            <option value="@department"
                                    selected="@(ViewBag.Department == department ? "selected" : null)">
                                @department
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-search"></i>
                        Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>
    </div>

    <!-- Employee Table -->

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Employee ID</th>
                            <th>Full Name</th>
                            <th>Department</th>
                            <th>Email</th>
                            <th>Designation</th>
                            <th>Join Date</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var employee in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            @employee.EmployeeId
                                        </span>
                                    </td>

                                    <td>
                                        @employee.FullName
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark">
                                            @employee.Department
                                        </span>
                                    </td>

                                    <td>
                                        @employee.Email
                                    </td>

                                    <td>
                                        @employee.Designation
                                    </td>

                                    <td>
                                        @employee.JoinDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@employee.EmployeeId"
                                               class="btn btn-sm btn-outline-info"
                                               title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@employee.EmployeeId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@employee.EmployeeId"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete"
                                                        onclick="return confirm('Are you sure you want to delete this employee?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-5 text-muted">

                                    No employees found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
