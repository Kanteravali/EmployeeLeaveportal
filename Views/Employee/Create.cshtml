@model EmployeeLeavePortal.Models.Employee

@{
    ViewData["Title"] = "Add Employee";
}

<div class="container-fluid py-2">

    <!-- Page Heading -->

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Add Employee</h2>

        <p class="text-muted mb-0">
            Add a new employee to the organization
        </p>
    </div>


    <!-- Employee Form -->

    <div class="card shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <!-- Employee ID -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="EmployeeId"
                               class="form-label fw-semibold">
                            Employee ID
                        </label>

                        <input asp-for="EmployeeId"
                               class="form-control"
                               placeholder="Example: EMP-007" />

                        <span asp-validation-for="EmployeeId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Full Name -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="FullName"
                               class="form-label fw-semibold">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Enter full name" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Department and Designation -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Department"
                               class="form-label fw-semibold">
                            Department
                        </label>

                        <select asp-for="Department"
                                class="form-select">

                            <option value="">
                                Select Department
                            </option>

                            <option value="Engineering">
                                Engineering
                            </option>

                            <option value="HR">
                                HR
                            </option>

                            <option value="Operations">
                                Operations
                            </option>

                            <option value="Finance">
                                Finance
                            </option>

                        </select>

                        <span asp-validation-for="Department"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Designation"
                               class="form-label fw-semibold">
                            Designation
                        </label>

                        <input asp-for="Designation"
                               class="form-control"
                               placeholder="Example: Software Engineer" />

                        <span asp-validation-for="Designation"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Email and Join Date -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="example@company.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="JoinDate"
                               class="form-label fw-semibold">
                            Join Date
                        </label>

                        <input asp-for="JoinDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="JoinDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Buttons -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Save Employee

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
